# Copy this file to .env and fill in the values before running make start.

# Metabase Enterprise image tag (e.g. 1.62.2.x to float on latest patch)
MB_IMAGE_TAG=1.62.2.x

# Port Metabase is exposed on
METABASE_PORT=3300

# Your Metabase Enterprise embedding token
MB_PREMIUM_EMBEDDING_TOKEN=your-token-here
